@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="page">
    <!-- 桌面端侧边栏 -->
    <div class="sidebar d-none d-md-block">
        <NavMenu />
    </div>

    <main class="main-content">
        <!-- PWA 安装提示横幅 -->
        @if (_showInstallBanner)
        {
            <div class="install-banner d-md-none">
                <span>📱 添加到主屏幕，享受原生体验</span>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-primary" @onclick="InstallPwa">安装</button>
                    <button class="btn btn-sm btn-outline-light" @onclick="DismissInstall">✕</button>
                </div>
            </div>
        }

        <article class="content px-3">
            @Body
        </article>

        <!-- 底部安全区域占位（给底部导航腾空间）-->
        <div class="d-md-none" style="height: 70px;"></div>
    </main>
</div>

<!-- 移动端底部导航栏 -->
<nav class="bottom-nav d-md-none">
    <a href="/" class="bottom-nav-item @(IsActive("/", exact: true))">
        <span class="nav-icon">🏠</span>
        <span class="nav-label">首页</span>
    </a>
    <a href="/recipes" class="bottom-nav-item @(IsActive("/recipes"))">
        <span class="nav-icon">📖</span>
        <span class="nav-label">菜谱</span>
    </a>
    <a href="/chat" class="bottom-nav-item @(IsActive("/chat"))">
        <span class="nav-icon">💬</span>
        <span class="nav-label">聊天</span>
    </a>
    <a href="/live" class="bottom-nav-item @(IsActive("/live"))">
        <span class="nav-icon">📡</span>
        <span class="nav-label">直播</span>
    </a>
    <a href="/shopping" class="bottom-nav-item @(IsActive("/shopping"))">
        <span class="nav-icon">🛒</span>
        <span class="nav-label">购物</span>
    </a>
</nav>

<style>
    /* ── 底部导航栏 ── */
    .bottom-nav {
        position: fixed;
        bottom: 0; left: 0; right: 0;
        height: 60px;
        background: #fff;
        border-top: 1px solid #dee2e6;
        display: flex;
        z-index: 1000;
        padding-bottom: env(safe-area-inset-bottom);
        box-shadow: 0 -2px 12px rgba(0,0,0,0.08);
    }
    .bottom-nav-item {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        color: #6c757d;
        gap: 2px;
        transition: color 0.15s;
    }
    .bottom-nav-item.active {
        color: #1b6ec2;
    }
    .nav-icon { font-size: 1.4rem; line-height: 1; }
    .nav-label { font-size: 0.65rem; font-weight: 500; }

    /* ── PWA 安装横幅 ── */
    .install-banner {
        background: #1b6ec2;
        color: #fff;
        padding: 8px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.85rem;
        gap: 8px;
    }

    /* ── 移动端内容区 ── */
    @@media (max-width: 767px) {
        .main-content { margin-left: 0 !important; }
        .content { padding-bottom: 16px; }
    }
</style>

@code {
    private bool _showInstallBanner;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // 检查是否可以安装（Android Chrome 会触发 beforeinstallprompt）
        try
        {
            var installed = await JS.InvokeAsync<bool>("isPwaInstalled");
            if (!installed)
            {
                // iOS 没有 beforeinstallprompt，直接显示提示
                var isIos = await JS.InvokeAsync<bool>("eval",
                    "/iphone|ipad|ipod/i.test(navigator.userAgent)");
                if (isIos) _showInstallBanner = true;
                StateHasChanged();
            }
        }
        catch { }
    }

    private async Task InstallPwa()
    {
        try { await JS.InvokeAsync<bool>("showInstallPrompt"); }
        catch { }
        _showInstallBanner = false;
    }

    private void DismissInstall() => _showInstallBanner = false;

    private string IsActive(string href, bool exact = false)
    {
        var current = Navigation.Uri.Replace(Navigation.BaseUri, "/");
        if (!current.StartsWith("/")) current = "/" + current;
        if (exact) return current == href ? "active" : "";
        return current.StartsWith(href) && href != "/" ? "active" : "";
    }
}
