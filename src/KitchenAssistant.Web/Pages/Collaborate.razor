@page "/collaborate"
@inject AppState AppState
@inject ChatService ChatService
@inject RecipeService RecipeService
@inject NavigationManager Navigation
@implements IAsyncDisposable

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>👥 协作烹饪</h2>
    </div>

    @if (!AppState.IsLoggedIn)
    {
        <div class="text-center mt-5">
            <div class="display-1 text-muted mb-3">🔒</div>
            <p class="text-muted">请先在首页输入昵称加入协作</p>
            <button class="btn btn-primary" @onclick="GoHome">返回首页</button>
        </div>
    }
    else if (!ChatService.IsConnected)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary mb-3" role="status">
                <span class="visually-hidden">加载中...</span>
            </div>
            <p class="text-muted">正在连接协作服务器...</p>
        </div>
    }
    else if (_selectedSession == null)
    {
        <div class="row g-4">
            <div class="col-md-8">
                <div class="card shadow h-100">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">正在进行的会话</h5>
                        <button class="btn btn-sm btn-primary" @onclick="ShowCreateModal">
                            ➕ 创建会话
                        </button>
                    </div>
                    <div class="card-body">
                        @if (ChatService.ActiveSessions.Count == 0)
                        {
                            <div class="text-center py-5">
                                <div class="display-4 text-muted mb-3">🍳</div>
                                <p class="text-muted mb-3">暂无进行中的烹饪会话</p>
                                <button class="btn btn-primary" @onclick="ShowCreateModal">创建第一个烹饪会话</button>
                            </div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var session in ChatService.ActiveSessions.OrderByDescending(s => s.StartTime))
                                {
                                    <div class="list-group-item list-group-item-action d-flex align-items-center">
                                        <div class="flex-grow-1">
                                            <div class="d-flex align-items-center gap-2">
                                            <h6 class="mb-1">@session.Name</h6>
                                            <span class="badge @GetStatusBadgeClass(session.Status)">@GetStatusText(session.Status)</span>
                                            </div>
                                            <p class="mb-1 small text-muted">
                                                主持: @session.HostUserName | 成员: @session.Participants.Count 人
                                            </p>
                                        </div>
                                        <button class="btn btn-outline-primary btn-sm" @onclick="() => SelectSession(session)">
                                            进入
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow">
                    <div class="card-header bg-white">
                        <h6 class="mb-0">👥 在线成员 (@ChatService.OnlineUsers.Count)</h6>
                    </div>
                    <div class="card-body p-0">
                        @if (ChatService.OnlineUsers.Count == 0)
                        {
                            <p class="text-muted text-center py-3">暂无在线成员</p>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                            @foreach (var user in ChatService.OnlineUsers)
                            {
                                <div class="list-group-item d-flex align-items-center">
                                    <div class="d-flex align-items-center gap-2 flex-grow-1">
                                        <div class="badge bg-success rounded-circle" style="width: 8px; height: 8px;"></div>
                                        <span>@user.Name</span>
                                    </div>
                                    <small class="text-muted">@user.JoinedAt.ToString("HH:mm")</small>
                                </div>
                            }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-md-8">
                <div class="card shadow">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <div>
                            <button class="btn btn-sm btn-outline-secondary me-2" @onclick="BackToList">
                            ← 返回
                            </button>
                            <h5 class="mb-0 d-inline">@_selectedSession.Name</h5>
                        </div>
                        <span class="badge @GetStatusBadgeClass(_selectedSession.Status)">
                            @GetStatusText(_selectedSession.Status)
                        </span>
                    </div>
                    <div class="card-body">
                        <h6 class="mb-3">📋 烹饪步骤</h6>
                        @if (_recipeSteps.Count == 0)
                        {
                            <p class="text-muted text-center py-3">选择菜谱后自动加载步骤</p>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                            @for (int i = 0; i < _recipeSteps.Count; i++)
                            {
                                var step = _recipeSteps[i];
                                var task = _selectedSession.TaskAssignments.FirstOrDefault(t => t.StepIndex == i);
                                var isAssigned = task != null;
                                var isCompleted = task?.Status == KitchenAssistant.Core.Models.TaskStatus.Completed;
                                var isAssignedToMe = task?.AssignedUserName == AppState.UserName;

                                <div class="list-group-item @(isCompleted ? "bg-success bg-opacity-10" : "")">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="badge @(isCompleted ? "bg-success" : "bg-secondary")" style="width: 30px; height: 30px; display: flex; align-items: center; justify-content: center;">
                                            @(i + 1)
                                        </div>
                                        <div class="flex-grow-1">
                                            <p class="mb-1 @(isCompleted ? "text-decoration-line-through text-muted" : "")">@step</p>
                                            @if (isAssigned)
                                            {
                                                <small class="text-muted">
                                                    👤 @task!.AssignedUserName
                                                    @if (task.Status == KitchenAssistant.Core.Models.TaskStatus.InProgress)
                                                    {
                                                        <span class="text-warning ms-2">进行中...</span>
                                                    }
                                                    @if (task.Status == KitchenAssistant.Core.Models.TaskStatus.Completed)
                                                    {
                                                        <span class="text-success ms-2">✓ 已完成</span>
                                                    }
                                                </small>
                                            }
                                        </div>
                                        @if (!isCompleted)
                                        {
                                            if (isAssignedToMe)
                                            {
                                                <button class="btn btn-sm btn-success" @onclick="() => CompleteTask(i)">
                                                    完成
                                                </button>
                                            }
                                            else if (!isAssigned)
                                            {
                                                <button class="btn btn-sm btn-outline-primary" @onclick="() => AssignTask(i, step)">
                                                    认领
                                                </button>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow mb-4">
                    <div class="card-header bg-white">
                        <h6 class="mb-0">👥 会话成员 (@_selectedSession.Participants.Count)</h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush">
                            @foreach (var p in _selectedSession.Participants)
                            {
                                <div class="list-group-item d-flex align-items-center">
                                    <div class="badge bg-success rounded-circle me-2" style="width: 8px; height: 8px;"></div>
                                    <span>@p.UserName</span>
                                    @if (p.UserId == _selectedSession.HostUserId)
                                    {
                                        <span class="badge bg-info ms-2">主持</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="card shadow">
                    <div class="card-header bg-white">
                        <h6 class="mb-0">📊 进度</h6>
                    </div>
                    <div class="card-body">
                        @{
                            var total = _recipeSteps.Count;
                            var completed = _selectedSession.TaskAssignments.Count(t => t.Status == KitchenAssistant.Core.Models.TaskStatus.Completed);
                            var progress = total > 0 ? completed * 100 / total : 0;
                        }
                        <div class="progress mb-2" style="height: 12px;">
                            <div class="progress-bar bg-success" style="width: @progress%;"></div>
                        </div>
                        <p class="text-center mb-0 small text-muted">
                            已完成 @completed / @total 步
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- 创建会话弹窗 -->
@if (_showCreateModal)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">创建烹饪会话</h5>
                    <button type="button" class="btn-close" @onclick="() => _showCreateModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">选择菜谱</label>
                        <select class="form-select" @bind="_selectedRecipeId">
                            <option value="">-- 请选择菜谱 --</option>
                            @foreach (var recipe in RecipeService.GetAllRecipes())
                            {
                                <option value="@recipe.Id">@recipe.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => _showCreateModal = false">取消</button>
                    <button type="button" class="btn btn-primary" @onclick="CreateSession" disabled="@(string.IsNullOrEmpty(_selectedRecipeId))">创建</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _showCreateModal;
    private string _selectedRecipeId = string.Empty;
    private CookingSession? _selectedSession;
    private List<string> _recipeSteps = [];

    protected override async Task OnInitializedAsync()
    {
        ChatService.OnUpdate += StateHasChanged;

        if (AppState.IsLoggedIn)
        {
            await ConnectIfNeeded();
        }
    }

    private async Task ConnectIfNeeded()
    {
        if (!ChatService.IsConnected && AppState.IsLoggedIn)
        {
            try
            {
                await ChatService.ConnectAsync(AppState.UserName!);
                StateHasChanged();
            }
            catch
            {
            }
        }
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }

    private void ShowCreateModal()
    {
        _showCreateModal = true;
    }

    private async Task CreateSession()
    {
        if (string.IsNullOrEmpty(_selectedRecipeId)) return;

        var recipeId = Guid.Parse(_selectedRecipeId);
        var recipe = RecipeService.GetRecipeById(recipeId);

        if (recipe != null)
        {
            var sessionId = await ChatService.CreateCookingSessionAsync(recipe.Name, recipeId);
            if (sessionId != Guid.Empty)
            {
                await ChatService.JoinCookingSessionAsync(sessionId);
                var session = ChatService.ActiveSessions.FirstOrDefault(s => s.Id == sessionId);
                if (session != null)
                {
                    SelectSession(session);
                }
            }
        }

        _showCreateModal = false;
    }

    private void SelectSession(CookingSession session)
    {
        _selectedSession = session;
        var recipe = RecipeService.GetRecipeById(session.RecipeId);
        _recipeSteps = recipe?.Steps.Select(s => s.Instruction).ToList() ?? [];
    }

    private void BackToList()
    {
        _selectedSession = null;
        _recipeSteps = [];
    }

    private async Task AssignTask(int stepIndex, string stepDescription)
    {
        if (_selectedSession == null) return;
        await ChatService.AssignTaskAsync(_selectedSession.Id, stepIndex, stepDescription);
    }

    private async Task CompleteTask(int stepIndex)
    {
        if (_selectedSession == null) return;
        await ChatService.CompleteTaskAsync(_selectedSession.Id, stepIndex);
    }

    private string GetStatusBadgeClass(CookingSessionStatus status) => status switch
    {
        CookingSessionStatus.Preparing => "bg-info",
        CookingSessionStatus.Cooking => "bg-warning",
        CookingSessionStatus.Paused => "bg-secondary",
        CookingSessionStatus.Completed => "bg-success",
        CookingSessionStatus.Cancelled => "bg-danger",
        _ => "bg-secondary"
    };

    private string GetStatusText(CookingSessionStatus status) => status switch
    {
        CookingSessionStatus.Preparing => "准备中",
        CookingSessionStatus.Cooking => "烹饪中",
        CookingSessionStatus.Paused => "已暂停",
        CookingSessionStatus.Completed => "已完成",
        CookingSessionStatus.Cancelled => "已取消",
        _ => "未知"
    };

    public async ValueTask DisposeAsync()
    {
        ChatService.OnUpdate -= StateHasChanged;
        await ChatService.DisposeAsync();
    }
}
