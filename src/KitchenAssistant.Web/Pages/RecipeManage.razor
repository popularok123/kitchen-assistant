@page "/recipes/manage"
@inject RecipeService RecipeService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>菜谱管理</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <button class="btn btn-outline-secondary btn-sm me-2" @onclick='() => Navigation.NavigateTo("/recipes")'>
                ← 返回列表
            </button>
            <h2 class="d-inline">📝 菜谱管理</h2>
        </div>
        <button class="btn btn-primary" @onclick="ShowAddForm">
            ➕ 新增菜谱
        </button>
    </div>

    @if (_editingRecipe != null)
    {
        <div class="card shadow mb-4 border-primary">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">@(_isEditing ? "编辑菜谱" : "新增菜谱")</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">菜谱名称 <span class="text-danger">*</span></label>
                        <input @bind="_editingRecipe.Name" class="form-control" placeholder="如：番茄炒蛋" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">烹饪时间（分钟）</label>
                        <input @bind="_editingRecipe.CookTimeMinutes" type="number" class="form-control" min="1" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">难度</label>
                        <select @bind="_editingRecipe.DifficultyLevel" class="form-select">
                            <option value="1">⭐ 简单</option>
                            <option value="2">⭐⭐ 中等</option>
                            <option value="3">⭐⭐⭐ 较难</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">简介</label>
                        <input @bind="_editingRecipe.Description" class="form-control" placeholder="一句话描述这道菜" />
                    </div>
                </div>

                <hr class="my-4" />

                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">食材清单</label>
                        <p class="text-muted small mb-2">格式：食材名 数量（如：鸡蛋 3个）</p>
                        @for (int i = 0; i < _editingRecipe.Ingredients.Count; i++)
                        {
                            var idx = i;
                            <div class="input-group mb-2">
                                <input @bind="_editingRecipe.Ingredients[idx]" class="form-control" placeholder="食材 数量" />
                                <button class="btn btn-outline-danger" type="button"
                                        @onclick="() => RemoveIngredient(idx)">🗑️</button>
                            </div>
                        }
                        <button class="btn btn-outline-secondary btn-sm" @onclick="AddIngredient">
                            ➕ 添加食材
                        </button>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">烹饪步骤</label>
                        @for (int i = 0; i < _editingRecipe.Steps.Count; i++)
                        {
                            var idx = i;
                            var step = _editingRecipe.Steps[idx];
                            <div class="card mb-2">
                                <div class="card-body p-2">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge bg-secondary">@(idx + 1)</span>
                                        <input @bind="step.Instruction" class="form-control form-control-sm"
                                               placeholder="步骤说明" />
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => RemoveStep(idx)">🗑️</button>
                                    </div>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text">⏱️ 秒</span>
                                        <input @bind="step.DurationSeconds" type="number" class="form-control"
                                               placeholder="0" min="0" />
                                    </div>
                                </div>
                            </div>
                        }
                        <button class="btn btn-outline-secondary btn-sm" @onclick="AddStep">
                            ➕ 添加步骤
                        </button>
                    </div>
                </div>

                <div class="mt-3">
                    <label class="form-label fw-semibold">小贴士（可选，每条一行）</label>
                    <textarea @bind="_tipsText" class="form-control" rows="2"
                              placeholder="烹饪技巧，每行一条"></textarea>
                </div>
            </div>
            <div class="card-footer bg-white d-flex gap-2 justify-content-end">
                <button class="btn btn-secondary" @onclick="CancelEdit">取消</button>
                <button class="btn btn-primary" @onclick="SaveRecipe"
                        disabled="@string.IsNullOrWhiteSpace(_editingRecipe.Name)">
                    💾 保存
                </button>
            </div>
        </div>
    }

    <div class="card shadow">
        <div class="card-header bg-white">
            <h6 class="mb-0">自定义菜谱 (@RecipeService.CustomRecipes.Count)</h6>
        </div>
        @if (RecipeService.CustomRecipes.Count == 0)
        {
            <div class="card-body text-center py-5 text-muted">
                <div class="display-4 mb-3">📝</div>
                <p>还没有自定义菜谱</p>
                <p class="small">点击右上角「新增菜谱」开始创建</p>
            </div>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var recipe in RecipeService.CustomRecipes)
                {
                    <div class="list-group-item d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-semibold">@recipe.Name</span>
                                <span class="badge bg-light text-dark border">@(new string('⭐', recipe.DifficultyLevel))</span>
                                <span class="text-muted small">⏱️ @recipe.CookTimeMinutes 分钟</span>
                                <span class="text-muted small">🥬 @recipe.Ingredients.Count 种食材</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(recipe.Description))
                            {
                                <small class="text-muted">@recipe.Description</small>
                            }
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => EditRecipe(recipe)">
                                ✏️ 编辑
                            </button>
                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => ConfirmDelete(recipe.Id)">
                                🗑️ 删除
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (_deleteTargetId != Guid.Empty)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-body text-center py-4">
                    <div class="display-4 mb-2">🗑️</div>
                    <p class="fw-semibold">确认删除这个菜谱？</p>
                    <p class="text-muted small">此操作不可撤销</p>
                </div>
                <div class="modal-footer justify-content-center gap-2">
                    <button class="btn btn-secondary" @onclick="() => _deleteTargetId = Guid.Empty">取消</button>
                    <button class="btn btn-danger" @onclick="DeleteRecipe">删除</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private Recipe? _editingRecipe;
    private bool _isEditing;
    private string _tipsText = string.Empty;
    private Guid _deleteTargetId = Guid.Empty;

    private void ShowAddForm()
    {
        _isEditing = false;
        _editingRecipe = new Recipe { DifficultyLevel = 1, CookTimeMinutes = 30 };
        _editingRecipe.Ingredients.Add(string.Empty);
        _editingRecipe.Steps.Add(new CookingStep { Order = 1 });
        _tipsText = string.Empty;
    }

    private void EditRecipe(Recipe recipe)
    {
        _isEditing = true;
        _editingRecipe = new Recipe
        {
            Id = recipe.Id,
            Name = recipe.Name,
            Description = recipe.Description,
            CookTimeMinutes = recipe.CookTimeMinutes,
            DifficultyLevel = recipe.DifficultyLevel,
            Ingredients = [.. recipe.Ingredients],
            Steps = recipe.Steps.Select(s => new CookingStep
            {
                Order = s.Order, Instruction = s.Instruction, DurationSeconds = s.DurationSeconds
            }).ToList(),
            Tips = [.. recipe.Tips]
        };
        _tipsText = string.Join("\n", recipe.Tips);
    }

    private void AddIngredient() => _editingRecipe!.Ingredients.Add(string.Empty);

    private void RemoveIngredient(int index)
    {
        if (_editingRecipe!.Ingredients.Count > 1)
            _editingRecipe.Ingredients.RemoveAt(index);
    }

    private void AddStep()
    {
        var order = _editingRecipe!.Steps.Count + 1;
        _editingRecipe.Steps.Add(new CookingStep { Order = order });
    }

    private void RemoveStep(int index)
    {
        if (_editingRecipe!.Steps.Count > 1)
            _editingRecipe.Steps.RemoveAt(index);
    }

    private void SaveRecipe()
    {
        if (_editingRecipe == null || string.IsNullOrWhiteSpace(_editingRecipe.Name)) return;

        _editingRecipe.Ingredients.RemoveAll(string.IsNullOrWhiteSpace);
        _editingRecipe.Steps.RemoveAll(s => string.IsNullOrWhiteSpace(s.Instruction));
        for (int i = 0; i < _editingRecipe.Steps.Count; i++)
            _editingRecipe.Steps[i].Order = i + 1;

        _editingRecipe.Tips = _tipsText
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

        if (_isEditing)
        {
            RecipeService.DeleteRecipe(_editingRecipe.Id);
            RecipeService.AddRecipe(_editingRecipe);
        }
        else
        {
            RecipeService.AddRecipe(_editingRecipe);
        }

        CancelEdit();
    }

    private void CancelEdit() => _editingRecipe = null;

    private void ConfirmDelete(Guid id) => _deleteTargetId = id;

    private void DeleteRecipe()
    {
        RecipeService.DeleteRecipe(_deleteTargetId);
        _deleteTargetId = Guid.Empty;
    }

    protected override void OnInitialized()
    {
        RecipeService.OnFavoritesChanged += StateHasChanged;
    }

    public void Dispose()
    {
        RecipeService.OnFavoritesChanged -= StateHasChanged;
    }
}
