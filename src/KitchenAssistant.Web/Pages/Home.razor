@page "/"
@inject AppState AppState
@inject NavigationManager Navigation

<PageTitle>厨房协作助手</PageTitle>

<div class="min-vh-100 d-flex align-items-center justify-content-center py-4">
    <div class="container">
        @if (!AppState.IsLoggedIn)
        {
            <div class="row justify-content-center">
                <div class="col-lg-5 col-md-7">
                    <div class="text-center mb-5">
                        <div class="display-1 mb-3">🍳</div>
                        <h1 class="display-5 fw-bold mb-2">厨房协作助手</h1>
                        <p class="lead text-muted">让做饭变得更简单、更有趣</p>
                    </div>

                    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                        <div class="card-body p-5">
                            <h3 class="card-title text-center mb-4">👋 欢迎来到厨房</h3>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">选择你的头像</label>
                                <div class="d-flex flex-wrap gap-2 justify-content-center">
                                    @foreach (var avatar in AppState.DefaultAvatars)
                                    {
                                        <button type="button"
                                                class="btn @(AppState.Avatar == avatar ? "btn-primary" : "btn-outline-secondary") rounded-circle p-2"
                                                style="width: 50px; height: 50px; font-size: 1.5rem;"
                                                @onclick="() => SelectAvatar(avatar)">
                                            @avatar
                                        </button>
                                    }
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">你的昵称</label>
                                <input @bind="_userName" type="text"
                                       class="form-control form-control-lg py-3"
                                       placeholder="输入你的昵称"
                                       @onkeyup="HandleKeyUp"
                                       autofocus>
                            </div>

                            <button class="btn btn-primary btn-lg w-100 py-3 fw-semibold"
                                    @onclick="EnterApp"
                                    disabled="@string.IsNullOrWhiteSpace(_userName)">
                                进入厨房 🍳
                            </button>

                            <div class="mt-4 text-center">
                                <p class="text-muted small mb-0">
                                    <i class="bi bi-info-circle"></i>
                                    输入昵称即可开始，无需注册
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="text-center mb-5">
                        <div class="display-4 mb-3">@AppState.Avatar</div>
                        <h1 class="display-5 fw-bold mb-2">你好，@AppState.UserName！</h1>
                        <p class="lead text-muted">今天想做什么呢？</p>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="card h-100 shadow hover-card border-0 rounded-4" @onclick="GoToRecipes">
                                <div class="card-body text-center p-5">
                                    <div class="display-3 mb-3">📖</div>
                                    <h3 class="fw-bold">菜谱大全</h3>
                                    <p class="text-muted mt-2 mb-0">浏览精选菜谱，开始烹饪</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card h-100 shadow hover-card border-0 rounded-4" @onclick="GoToChat">
                                <div class="card-body text-center p-5">
                                    <div class="display-3 mb-3">💬</div>
                                    <h3 class="fw-bold">厨房聊天室</h3>
                                    <p class="text-muted mt-2 mb-0">与家人朋友实时交流</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card h-100 shadow hover-card border-0 rounded-4" @onclick="GoToCollaborate">
                                <div class="card-body text-center p-5">
                                    <div class="display-3 mb-3">👥</div>
                                    <h3 class="fw-bold">协作烹饪</h3>
                                    <p class="text-muted mt-2 mb-0">多人同步，一起做饭</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card h-100 shadow hover-card border-0 rounded-4" @onclick="GoToShopping">
                                <div class="card-body text-center p-5">
                                    <div class="display-3 mb-3">🛒</div>
                                    <h3 class="fw-bold">购物清单</h3>
                                    <p class="text-muted mt-2 mb-0">管理食材采购清单</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="text-center mt-5">
                        <button class="btn btn-outline-secondary" @onclick="Logout">
                            切换账号
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .hover-card {
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,0.175) !important;
    }
</style>

@code {
    private string _userName = string.Empty;

    protected override void OnInitialized()
    {
        if (AppState.IsLoggedIn)
        {
            _userName = AppState.UserName;
        }
    }

    private void SelectAvatar(string avatar)
    {
        AppState.Avatar = avatar;
    }

    private void EnterApp()
    {
        if (!string.IsNullOrWhiteSpace(_userName))
        {
            AppState.UserName = _userName;
        }
    }

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_userName))
        {
            EnterApp();
        }
    }

    private void Logout()
    {
        AppState.Logout();
        _userName = string.Empty;
    }

    private void GoToRecipes() => Navigation.NavigateTo("/recipes");
    private void GoToChat() => Navigation.NavigateTo("/chat");
    private void GoToCollaborate() => Navigation.NavigateTo("/collaborate");
    private void GoToShopping() => Navigation.NavigateTo("/shopping");
}
